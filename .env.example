# Copy to .env and adjust. Compose reads .env from the directory it runs in, so place
# the copy in the stack directory you are starting, or export the variable instead.

# Licence key store. Only needed if the key is not in this repository's keys/ directory.
# The store is a directory of four-digit year subdirectories, each with one or more
# *.key files; common/start.sh takes the newest year that has a key.
#
#   <IRIS_KEY_DIR>/2026/iris.key
#
# Relative paths are resolved from the stack directory, so the default ../keys is the
# keys/ directory at the top of this repository.
IRIS_KEY_DIR=../keys
