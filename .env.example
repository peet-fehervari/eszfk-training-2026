# Copy to .env and adjust. Compose reads .env from the directory it runs in, so place
# the copy in the stack directory you are starting, or export the variable instead.

# Licence key store: a directory containing four-digit year subdirectories, each with
# one or more *.key files. common/start.sh takes the newest year that has a key.
#
#   <IRIS_KEY_DIR>/2026/iris.key
#
# Relative paths are resolved from the stack directory. The default below is a sibling
# of this repository's parent directory.
IRIS_KEY_DIR=../../../keys
