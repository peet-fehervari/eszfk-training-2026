# Copy to .env and adjust. Compose reads .env from the directory it runs in, so place
# the copy in the stack directory you are starting, or export the variable instead.
#
# Nothing here has to be set: every variable below has a working default.

# Licence key store. Only needed if the key is not in this repository's keys/ directory.
# The store is a directory of four-digit year subdirectories, each with one or more
# *.key files; common/start.sh takes the newest year that has a key.
#
#   <IRIS_KEY_DIR>/2026/iris.key
#
# Relative paths are resolved from the stack directory, so the default ../keys is the
# keys/ directory at the top of this repository.
IRIS_KEY_DIR=../keys

# Cores each IRIS instance may use. IRIS matches the licence against the cores it can
# see, and on a host with more cores than the key allows it quietly falls back to a
# minimal licence, which only shows up later as missing Interoperability or HTTP 503.
# Lower this if the host is small and several stacks run at once.
IRIS_CPUS=2.0

# Host ports. Every published port in every stack is overridable, and the value below is
# the default the READMEs and the exercise texts use - change one only when you have to.
#
# On a Windows host WinNAT reserves blocks of high ports dynamically and a reserved
# port cannot be published at all: Compose fails with
# "/forwards/expose returned unexpected status: 500" and nothing is listening, which
# looks like a Docker fault rather than a port conflict. That is the one situation these
# variables exist for. The reserved blocks change across reboots, so list them and pick a
# port outside every block:
#
#   netsh int ipv4 show excludedportrange tcp
#
# Stack 1 - 01-health-single
PORT_HEALTH_SUPERSERVER=61972
PORT_HEALTH_PORTAL=61773

# Stack 2 - 02-code-data-ecp
PORT_CODE_SUPERSERVER=62972
PORT_DATA_SUPERSERVER=62973
PORT_CODE_PORTAL=62773
PORT_DATA_PORTAL=62774

# Stack 3 - 03-mirror-failover
PORT_MIRROR_A_SUPERSERVER=63972
PORT_MIRROR_B_SUPERSERVER=63973
PORT_MIRROR_A_AGENT=63188
PORT_MIRROR_B_AGENT=63189
PORT_MIRROR_A_PORTAL=63773
PORT_MIRROR_B_PORTAL=63774

# Optional containers, started only with their profile: --profile mail, --profile arbiter
PORT_MAIL_SMTP=61025
PORT_MAIL_UI=61026
PORT_ARBITER_AGENT=63190

# Images. The mail server is the one image that does not come from
# containers.intersystems.com, so on a machine where Docker Hub is unreachable it can
# be pointed at a mirror or a locally tagged copy.
MAILHOG_IMAGE=mailhog/mailhog:latest
IRIS_IMAGE=containers.intersystems.com/intersystems/iris:2026.1
